\addvspace {10\p@ }
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Approaches for monitoring manual assembly. The dashed box marks the two sensor types used in this thesis.}}{16}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Development of activity recognition with wrist-worn and body-worn motion and sound sensors. The dashed part of the time axis marks a gap of several years without closely related work.}}{19}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Hardware classes for running activity recognition models, ordered by available working memory. Dots mark devices used in related work. The thick line marks the M5StickC Plus2 used in this thesis, from its 520\,KB of internal SRAM to an additional 2\,MB of external PSRAM. Memory ranges are typical values and not exact limits. Memory of the Arduino Nano 33 BLE Sense and the Jetson TX2 from the manufacturers' data sheets {[}CITATION{]}.}}{23}{figure.2.3}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces The M5StickC Plus2 wearable device. The ESP32-PICO-V3-02 system-on-chip, the six-axis IMU (MPU6886), and the microphone (SPM1423) are all integrated on the board. Image: M5Stack~\cite {m5stickcplus2}.}}{29}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Architecture of the multimodal data-acquisition system. Each wearable device (four in sessions 1--3, three in sessions 4--6) samples an IMU and a microphone independently, timestamps and frames the samples, and streams them as two separate UDP streams (inertial on one port, audio on another) to a single host, which separates the devices by packet source address and writes raw per-device files.}}{32}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Signal-conditioning and windowing pipeline, applied per device. The inertial and acoustic branches are brought to fixed rates before both are cut on the same window boundaries.}}{37}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Window generation and majority-vote labelling. Two-second windows advance in one-second steps ($W_1$, $W_2$, $W_3$ shown stacked for clarity). A window takes the majority activity among its labelled samples; a window whose labelled coverage falls below 70\,\%, such as one spanning the transition region, is discarded.}}{40}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Number of two-second windows per activity class in the dominant-wrist dataset ($n = 2565$). \texttt {screw\_tightening} is the largest class with about 23\,\% of the windows, while \texttt {place\_container} is the smallest with 74 windows.}}{42}{figure.3.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Conversion of a two-second audio window into the log-mel spectrogram used as input to the acoustic models.}}{48}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Audio model with a shared convolutional stem and the three pooling variants: (a) global average pooling, (b) recurrent pooling with a bidirectional GRU, and (c) hybrid pooling, which concatenates both summaries.}}{50}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces The three fusion strategies. Early fusion combines the raw inputs before learning, embedding-level fusion combines learned 64-dimensional representations of two frozen backbones, and decision-level fusion combines the class probabilities of two independently trained models.}}{51}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Decision-level fusion with per-class weights (top) and the coordinate-ascent search used to determine the weights on the validation data (bottom).}}{54}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Export of a trained model to the device firmware. All constants used on the device are generated automatically from the training pipeline.}}{60}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Structure of the inference firmware. After the start-up phase, recording, preprocessing, inference and output are repeated continuously.}}{62}{figure.4.6}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Grouped splitting. Long activity occurrences are cut into blocks, and whole blocks are assigned to either the training or the validation set. Training windows that overlap a validation window are discarded. A random split would distribute overlapping windows across both sets.}}{64}{figure.4.7}%
